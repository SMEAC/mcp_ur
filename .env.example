# Bench configuration only. Which board to probe is chosen at runtime with
# robot_board(operation='load', file=<full path>) - there is no default board.

# Robot IP (pendant: Settings -> System -> Network), or SIM / SIM:UR5E for the built-in simulator.
UR_HOST=SIM
# Optional: ur3e or ur5e. A real robot must report this model or the server refuses to connect.
# UR_MODEL=ur3e
# Optional: folders searched for short board names (';'-separated, sub-folders included).
# UR_BOARDS_DIR=C:\bench\TestData
# URScript port: 30001 (primary, default) or 30002 (secondary).
# UR_SCRIPT_PORT=30001
# Home position if the board file has none (degrees, base..wrist3).
# UR_HOME_JOINTS_DEG=0,-90,90,-90,-90,0
# Enable the robot_script tool (raw URScript, bypasses all checks).
# UR_ALLOW_RAW_SCRIPT=1
# UR_LOG_LEVEL=WARNING
